# Root admin (used by setup_users.py)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGER-MOI

# Application database
MONGO_DB=FirstTry
MONGO_COLLECTION=mediccrud

# Application users
MONGO_APP_USERNAME=appuser
MONGO_APP_PASSWORD=CHANGER-MOI-APP
MONGO_READONLY_USERNAME=readonly
MONGO_READONLY_PASSWORD=CHANGER-MOI-RO

# Optional convenience URIs for local runs (do not log)
# For local host (outside Docker):
# MONGODB_URI=mongodb://appuser:${MONGO_APP_PASSWORD}@localhost:27017/${MONGO_DB}?authSource=${MONGO_DB}
