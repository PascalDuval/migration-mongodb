# Root admin (used by setup_users.py)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGER-MOI

# Mongo connection (host/port used by tests and helpers)
MONGO_HOST=localhost
MONGO_PORT=27017

# Application database
MONGO_DB=FirstTry
MONGO_COLLECTION=mediccrud

# Application users
MONGO_APP_USERNAME=appuser
MONGO_APP_PASSWORD=CHANGER-MOI-APP
MONGO_READONLY_USERNAME=readonly
MONGO_READONLY_PASSWORD=CHANGER-MOI-RO

# Optional convenience URIs (avoid printing them verbatim)
MONGO_URI_RW=mongodb://appuser:${MONGO_APP_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=${MONGO_DB}
MONGO_URI_RO=mongodb://readonly:${MONGO_READONLY_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=${MONGO_DB}
MONGODB_URI=${MONGO_URI_RW}

