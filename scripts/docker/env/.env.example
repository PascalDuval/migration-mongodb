# Nom du projet docker compose
COMPOSE_PROJECT_NAME=migration

# Version d'image MongoDB et port d'exposition
MONGODB_VERSION=6.0
MONGODB_PORT=27017

# Identifiants administrateur MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=supersecret
MONGO_INITDB_DATABASE=FirstTry

# Identifiants applicatifs avec droits étendus
MONGO_APP_DATABASE=FirstTry
MONGO_APP_USER=app_writer
MONGO_APP_PASSWORD=app_writer_password
MONGO_APP_ROLES=readWrite,dbOwner
MONGO_APP_AUTH_SOURCE=FirstTry

# Paramètres du client de migration
MIGRATION_MONGODB_URI=mongodb://app_writer:app_writer_password@mongodb:27017/FirstTry?authSource=FirstTry
MIGRATION_DEFAULT_DB=FirstTry
MIGRATION_DEFAULT_COLLECTION=mediccrud