# Example .env for docker-compose (do not commit real secrets)

# Root admin (used only by setup_users.py)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGER-MOI

# Application database
MONGO_DB=FirstTry
MONGO_COLLECTION=mediccrud

# App accounts
MONGO_APP_USERNAME=appuser
MONGO_APP_PASSWORD=CHANGER-MOI-APP
MONGO_READONLY_USERNAME=readonly
MONGO_READONLY_PASSWORD=CHANGER-MOI-RO

# Container connectivity for helper checks
# When running inside compose, Mongo hostname is the service name:
MONGO_HOST=mongodb
MONGO_PORT=27017

# Optional convenience URIs (avoid printing them in logs)
MONGODB_URI=mongodb://appuser:${MONGO_APP_PASSWORD}@mongodb:${MONGO_PORT}/${MONGO_DB}?authSource=${MONGO_DB}
MIGRATION_MONGODB_URI=mongodb://appuser:${MONGO_APP_PASSWORD}@mongodb:${MONGO_PORT}/${MONGO_DB}?authSource=${MONGO_DB}

